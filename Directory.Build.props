<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Product>Windows Diagnostics Lab</Product>
    <Authors>Windows Diagnostics Lab contributors</Authors>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Builds the Windows-only WPF project on non-Windows machines too (compile only). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Code reused read-only from project A (see vendor/local-ai-performance-center/manifest.json). -->
    <VendorA>$(MSBuildThisFileDirectory)vendor/local-ai-performance-center/src/</VendorA>
  </PropertyGroup>
</Project>
