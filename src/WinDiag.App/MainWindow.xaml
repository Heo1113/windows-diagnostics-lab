<Window x:Class="WinDiag.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinDiag.Presentation.ViewModels;assembly=WinDiag.Presentation"
        xmlns:views="clr-namespace:WinDiag.App.Views"
        xmlns:local="clr-namespace:WinDiag.App"
        Title="{Binding AppTitle}" Width="1480" Height="920" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}">
  <Window.Resources>
    <local:StatusBrushConverter x:Key="StatusBrush" />
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:EventsViewModel}"><views:EventsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><views:HardwareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TimelineViewModel}"><views:TimelineView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CompareViewModel}"><views:CompareView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding CollectionLevel, Converter={StaticResource StatusBrush}}" />
          <TextBlock Text="{Binding CollectionText}" Style="{StaticResource Value}" MaxWidth="520" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,18,0" />
          <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding SensorLevel, Converter={StaticResource StatusBrush}}" />
          <TextBlock Text="{Binding SensorText}" Style="{StaticResource Value}" MaxWidth="420" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding DatabaseText}" Style="{StaticResource Label}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Navigation -->
    <Border DockPanel.Dock="Left" Width="196" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,18,12,16">
          <TextBlock Text="Windows" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="Diagnostics Lab" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="16,8,12,14" Style="{StaticResource Caption}"
                   Text="진단 보조 도구입니다. 시스템 설정을 바꾸지 않으며 원인을 확정하지 않습니다." />
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="화면 선택">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="6,8">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="26" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Banners: mock sensors, virtual data, notices and notifications -->
    <StackPanel DockPanel.Dock="Top">
      <Border Background="{StaticResource MockBannerBrush}" Padding="14,8" Visibility="{Binding IsMock, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="⚠ MOCK 센서 - 테스트용 가상 센서 값입니다. 실제 하드웨어 측정이 아닙니다 (--mock-sensors로 실행됨)." />
      </Border>
      <Border Background="{StaticResource MockBannerBrush}" Padding="14,8" Visibility="{Binding HasVirtualData, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="⚠ 이 데이터베이스에 가상(테스트) 이벤트가 있습니다. '가상'으로 표시된 항목은 실제 PC 기록이 아닙니다." />
      </Border>
      <ItemsControl ItemsSource="{Binding Notifications}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#3a1d1d" BorderBrush="#5a2a2a" BorderThickness="0,0,0,1" Padding="14,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="닫기" Padding="8,1" Margin="6,0,0,0"
                        Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                <Button DockPanel.Dock="Right" Content="보기" Padding="8,1"
                        Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}">
                  <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                  <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding Level, Mode=OneWay, Converter={StaticResource StatusBrush}}" />
                  <Run Text="{Binding Message, Mode=OneWay}" />
                </TextBlock>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Notices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource InfoBannerBrush}" BorderBrush="{StaticResource InfoBannerBorderBrush}" BorderThickness="0,0,0,1" Padding="14,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="닫기" Padding="8,1"
                        Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                <TextBlock Text="{Binding StringFormat='ⓘ {0}'}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ContentControl Content="{Binding CurrentPage}" Margin="12,12,12,6" Focusable="False" />
  </DockPanel>
</Window>
