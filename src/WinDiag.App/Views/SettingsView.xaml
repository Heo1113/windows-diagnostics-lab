<UserControl x:Class="WinDiag.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinDiag.App">
  <UserControl.Resources>
    <local:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
  </UserControl.Resources>
  <DockPanel>
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button Content="저장" Command="{Binding SaveCommand}" Style="{StaticResource ToolButton}" />
        <Button Content="되돌리기" Command="{Binding RevertCommand}" Style="{StaticResource ToolButton}" />
      </StackPanel>
      <TextBlock Text="설정" Style="{StaticResource PageTitle}" />
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,8,4" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <UniformGrid Columns="2" VerticalAlignment="Top">
        <!-- Collection targets -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="수집 대상 (이벤트 로그)" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Channels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,2,0,6">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="24,0,0,0"><Run Text="{Binding Status, Mode=OneWay}" /> <Run Text="· 가장 오래된 기록" /> <Run Text="{Binding Oldest, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" Margin="24,0,0,0" Visibility="{Binding Detail, Converter={StaticResource NotEmpty}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,4,0,0">
              <Button DockPanel.Dock="Right" Content="로그 추가" Command="{Binding AddChannelCommand}" Margin="6,0,0,0" Padding="8,1" />
              <TextBox Text="{Binding NewChannel, UpdateSourceTrigger=PropertyChanged}" ToolTip="예: Microsoft-Windows-WindowsUpdateClient/Operational" />
            </DockPanel>
            <TextBlock Text="보안(Security) 로그는 관리자 권한이 필요하고 민감한 정보가 많아 이 버전에서는 수집하지 않습니다." Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="처음 실행 때 가져올 과거 기간 (일)" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding HistoryDays}" Margin="0,2" />
              <TextBlock Grid.Row="1" Text="새 이벤트 확인 간격 (초)" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PollSeconds}" Margin="0,2" />
            </Grid>
            <CheckBox Content="카탈로그에 없는 공급자의 경고도 수집 (기록이 많아질 수 있음)" IsChecked="{Binding CollectAllWarnings}" Margin="0,6,0,2" />
            <TextBlock Text="수집하지 않을 공급자 (쉼표로 구분)" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <TextBox Text="{Binding ExcludedProviders}" Margin="0,2" ToolTip="기본: DNS-Client(방문한 호스트 이름 포함), Security-Auditing" />
          </StackPanel>
        </Border>

        <!-- History import -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="과거 로그 가져오기" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="프로그램 실행 이전의 기록을 원하는 기간만큼 가져옵니다. 이미 저장된 이벤트는 다시 저장하지 않습니다. Windows에 남아 있는 기간까지만 가져올 수 있습니다." Style="{StaticResource Caption}" />
            <DockPanel Margin="0,6,0,0">
              <DatePicker SelectedDate="{Binding ImportFrom}" Width="150" />
              <TextBlock Text="~" Style="{StaticResource Label}" Margin="8,0" VerticalAlignment="Center" />
              <DatePicker SelectedDate="{Binding ImportTo}" Width="150" />
            </DockPanel>
            <Button Content="가져오기" Command="{Binding ImportHistoryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource ToolButton}" />
            <TextBlock Text="{Binding ImportProgress}" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="구성 스냅샷·덤프" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
              <TextBlock Text="구성 스냅샷 간격 (시간)" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding SnapshotHours}" Margin="0,2" />
            </Grid>
            <CheckBox Content="장치 드라이버 목록 포함 (WMI, 몇 초 걸릴 수 있음)" IsChecked="{Binding IncludeDrivers}" Margin="0,4" />
            <WrapPanel Margin="0,4,0,0">
              <Button Content="지금 스냅샷" Command="{Binding TakeSnapshotCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="덤프 파일 확인" Command="{Binding ScanDumpsCommand}" Style="{StaticResource ToolButton}" />
            </WrapPanel>
            <TextBlock Text="{Binding DumpStatus}" Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>

        <!-- Sensors, retention -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="센서 (프로젝트 A 센서 모듈)" Style="{StaticResource SectionTitle}" />
            <CheckBox Content="센서 기록 사용" IsChecked="{Binding SensorsEnabled}" Margin="0,2" />
            <CheckBox Content="GPU 센서 (NVIDIA NVML, 관리자 권한 불필요)" IsChecked="{Binding GpuEnabled}" Margin="0,2" />
            <CheckBox Content="CPU·RAM 센서 (Windows API, 관리자 권한 불필요)" IsChecked="{Binding SystemEnabled}" Margin="0,2" />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
              <TextBlock Text="센서 기록 간격 (초)" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding SensorInterval}" Margin="0,2" />
            </Grid>
            <TextBlock Text="데이터 보존" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="이벤트 보존 기간 (일, 0 = 제한 없음)" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding EventDays}" Margin="0,2" />
              <TextBlock Grid.Row="1" Text="센서 기록 보존 기간 (일)" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SensorDays}" Margin="0,2" />
              <TextBlock Grid.Row="2" Text="DB 크기 경고 기준 (MB)" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WarnDatabaseMb}" Margin="0,2" />
            </Grid>
            <Button Content="보존 정책 지금 적용" Command="{Binding ApplyRetentionCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Style="{StaticResource ToolButton}" />
            <TextBlock Text="데이터베이스 파일은 삭제하지 않습니다. 크기 기준은 경고만 표시합니다." Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>

        <!-- Notifications, privacy, analysis -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="알림" Style="{StaticResource SectionTitle}" />
            <CheckBox Content="중요한 새 이벤트를 화면에 알림" IsChecked="{Binding NotificationsEnabled}" Margin="0,2" />
            <CheckBox Content="Windows 알림 영역(트레이) 풍선도 표시" IsChecked="{Binding TrayBalloon}" Margin="0,2" />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="알림 최소 중요도" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding MinimumSeverity}" DisplayMemberPath="Name" Margin="0,2" />
              <TextBlock Grid.Row="1" Text="같은 문제 반복 알림 묶음 (분)" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding QuietMinutes}" Margin="0,2" />
            </Grid>
            <TextBlock Text="개인정보" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
            <CheckBox Content="수집할 때 사용자·컴퓨터 이름, 사용자 폴더 경로, SID, 이메일, 비밀값 가리기 (권장)" IsChecked="{Binding MaskAtCollection}" Margin="0,2" />
            <CheckBox Content="시각을 UTC로 표시 (끄면 현지 시간)" IsChecked="{Binding UseUtc}" Margin="0,2" />
            <TextBlock Text="외부 서버로 로그를 보내지 않고, 외부 AI API를 호출하지 않습니다. 내보내기 기본값은 '개인정보 최소'입니다." Style="{StaticResource Caption}" />
            <TextBlock Text="분석" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="동시 발생으로 볼 간격 (초)" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding CorrelationSeconds}" Margin="0,2" />
              <TextBlock Grid.Row="1" Text="이벤트 전후 센서 구간 (분)" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SensorWindowMinutes}" Margin="0,2" />
              <TextBlock Grid.Row="2" Text="반복 문제로 볼 최소 횟수" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RepeatThreshold}" Margin="0,2" />
              <TextBlock Grid.Row="3" Text="GPU 고온 기준 (°C)" Style="{StaticResource Label}" VerticalAlignment="Center" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HighGpuTemp}" Margin="0,2" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Data, backup -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="데이터·백업" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Value}" />
            <ItemsControl ItemsSource="{Binding DatabaseInfo}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding Note}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,8,0,0">
              <Button Content="백업" Command="{Binding BackupCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="백업 검증" Command="{Binding ValidateBackupCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="백업에서 복원" Command="{Binding RestoreCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="무결성 검사" Command="{Binding IntegrityCheckCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="데이터 폴더 열기" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="로그 폴더 열기" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource ToolButton}" />
            </WrapPanel>
            <TextBlock Text="테스트용" Style="{StaticResource CardTitle}" Margin="0,12,0,4" />
            <Button Content="가상 시나리오 데이터 불러오기" Command="{Binding LoadDemoDataCommand}" HorizontalAlignment="Left" Style="{StaticResource ToolButton}" />
            <TextBlock Text="화면 확인용 가상 데이터입니다. '가상'으로 표시되며 실제 PC 기록이 아닙니다." Style="{StaticResource Caption}" />
          </StackPanel>
        </Border>
      </UniformGrid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
