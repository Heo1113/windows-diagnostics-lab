<UserControl x:Class="WinDiag.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinDiag.App.Controls"
             xmlns:local="clr-namespace:WinDiag.App">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="400" />
    </Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
            <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Name" MinWidth="160" Margin="0,0,6,6" />
            <Button Content="새로 고침" Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}" />
            <Button Content="CSV 내보내기" Command="{Binding ExportCsvCommand}" Style="{StaticResource ToolButton}" />
          </StackPanel>
          <TextBlock Text="하드웨어" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <Border Style="{StaticResource Card}" Visibility="{Binding IsFocused, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="이벤트 보기 해제" Command="{Binding ClearFocusCommand}" Style="{StaticResource ToolButton}" />
              <TextBlock Text="{Binding FocusTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{Binding FocusNote}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <DataGrid ItemsSource="{Binding FocusStats}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" CanUserDeleteRows="False" Background="Transparent" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="지표" Binding="{Binding Metric, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="이전 평균" Binding="{Binding BeforeMean, Mode=OneWay}" Width="90" />
                <DataGridTextColumn Header="이전 최대" Binding="{Binding BeforeMax, Mode=OneWay}" Width="90" />
                <DataGridTextColumn Header="이벤트 시점" Binding="{Binding AtEvent, Mode=OneWay}" Width="90" />
                <DataGridTextColumn Header="이후 평균" Binding="{Binding AfterMean, Mode=OneWay}" Width="90" />
                <DataGridTextColumn Header="이후 최대" Binding="{Binding AfterMax, Mode=OneWay}" Width="90" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="센서 값과 이벤트가 같은 시각에 있다는 것은 시간적 관계일 뿐, 원인을 뜻하지 않습니다." Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding ChartNote}" Style="{StaticResource Caption}" Margin="8,0,8,4" />
        <TextBlock Text="차트 위에서 마우스 휠은 화면을 스크롤합니다. 시간축 확대·축소는 Ctrl+휠, 이동은 끌기입니다." Style="{StaticResource Caption}" Margin="8,0,8,4" />
        <UniformGrid Columns="2">
          <Border Style="{StaticResource Card}" Height="230"><c:ChartView Data="{Binding PowerChart}" Interactive="True" /></Border>
          <Border Style="{StaticResource Card}" Height="230"><c:ChartView Data="{Binding TempChart}" Interactive="True" /></Border>
          <Border Style="{StaticResource Card}" Height="230"><c:ChartView Data="{Binding UtilChart}" Interactive="True" /></Border>
          <Border Style="{StaticResource Card}" Height="230"><c:ChartView Data="{Binding ClockChart}" Interactive="True" /></Border>
          <Border Style="{StaticResource Card}" Height="230"><c:ChartView Data="{Binding CpuChart}" Interactive="True" /></Border>
          <Border Style="{StaticResource Card}" Height="230"><c:ChartView Data="{Binding RamChart}" Interactive="True" /></Border>
        </UniformGrid>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="8,0" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="현재 값" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Live}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding Note}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="장치·시스템 정보" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Info}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,2">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Value}" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Visibility="{Binding Note, Converter={StaticResource NotEmpty}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="센서 지원 현황" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Capabilities}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,2" ToolTip="{Binding Detail}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Value}" />
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Source, Mode=OneWay}" /> <Run Text="· 관리자 권한" /> <Run Text="{Binding Elevation, Mode=OneWay}" /></TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
