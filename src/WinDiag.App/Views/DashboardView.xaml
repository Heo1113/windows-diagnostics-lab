<UserControl x:Class="WinDiag.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinDiag.App.Controls"
             xmlns:local="clr-namespace:WinDiag.App">
  <UserControl.Resources>
    <local:StatusBrushConverter x:Key="StatusBrush" />
    <local:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="새로 고침" Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}" VerticalAlignment="Bottom" />
        <TextBlock Text="대시보드" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="6,0,6,12" />
      </DockPanel>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding OverallLevel, Converter={StaticResource StatusBrush}}" />
          <StackPanel>
            <TextBlock Text="{Binding OverallText}" Style="{StaticResource Value}" FontSize="15" />
            <TextBlock Style="{StaticResource Caption}">
              <Run Text="최근 24시간:" /> <Run Text="{Binding Last24h, Mode=OneWay}" /> <Run Text="   최근 7일:" /> <Run Text="{Binding Last7d, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="모두 확인함" Command="{Binding AcknowledgeCommand}" Style="{StaticResource ToolButton}"
                      ToolTip="지금까지의 이벤트를 확인한 것으로 표시합니다. 이후 수집되는 이벤트만 '새 오류'로 보입니다." />
              <TextBlock Text="새 경고·오류" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <TextBlock Text="{Binding NewCountText}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <DataGrid ItemsSource="{Binding NewEvents}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" MaxHeight="300">
              <DataGrid.Columns>
                <DataGridTextColumn Header="시각" Binding="{Binding Time, Mode=OneWay}" Width="140" />
                <DataGridTemplateColumn Header="중요도" Width="62">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Text="{Binding Severity}" Foreground="{Binding Level, Converter={StaticResource StatusBrush}}" Margin="2" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="분류" Binding="{Binding Category, Mode=OneWay}" Width="140" />
                <DataGridTextColumn Header="내용" Binding="{Binding Title, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="출처" Binding="{Binding Origin, Mode=OneWay}" Width="70" />
                <DataGridTemplateColumn Width="54">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="보기" Padding="6,0" Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="중요 경고 (최근 7일)" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Warnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,2,0,4">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Value}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Visibility="{Binding Note, Converter={StaticResource NotEmpty}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding MeasuredAt, StringFormat='측정 {0}'}" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding GpuName}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock Text="{Binding GpuUtil}" Style="{StaticResource BigValue}" ToolTip="GPU 사용률 (NVIDIA NVML 실측)" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="온도" Style="{StaticResource Label}" />
              <TextBlock Grid.Column="1" Text="{Binding GpuTemp}" Style="{StaticResource Value}" />
              <TextBlock Grid.Column="2" Text="전력 / 제한" Style="{StaticResource Label}" />
              <TextBlock Grid.Column="3" Text="{Binding GpuPower}" Style="{StaticResource Value}" />
              <TextBlock Grid.Row="1" Text="VRAM" Style="{StaticResource Label}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuVram}" Style="{StaticResource Value}" />
            </Grid>
            <TextBlock Text="{Binding SensorNote}" Style="{StaticResource Caption}" Visibility="{Binding SensorNote, Converter={StaticResource NotEmpty}}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="CPU · 시스템 메모리" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{Binding CpuUtil}" Style="{StaticResource BigValue}" ToolTip="전체 논리 프로세서 평균 CPU 사용률 (Windows API)" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="RAM 사용 / 전체" Style="{StaticResource Label}" />
              <TextBlock Grid.Column="1" Text="{Binding RamUsed}" Style="{StaticResource Value}" />
            </Grid>
            <TextBlock Text="CPU 온도·메모리 전압은 관리자 권한과 별도 드라이버가 필요해 이 버전에서는 수집하지 않습니다." Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Style="{StaticResource Card}" Height="260">
        <c:ChartView Data="{Binding Trend}" />
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="최근 시스템 충돌·비정상 종료 (7일)" Style="{StaticResource SectionTitle}" />
            <DataGrid ItemsSource="{Binding RecentCrashes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="시각" Binding="{Binding Time, Mode=OneWay}" Width="140" />
                <DataGridTextColumn Header="종류" Binding="{Binding Kind, Mode=OneWay}" Width="*" />
                <DataGridTemplateColumn Width="54">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="상세" Padding="6,0" Command="{Binding DataContext.OpenCrashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="수집 상태" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Channels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,2,0,4" ToolTip="{Binding Detail}">
                    <DockPanel>
                      <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,6,0" Fill="{Binding Level, Converter={StaticResource StatusBrush}}" />
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Value}" />
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="15,0,0,0">
                      <Run Text="마지막 확인" /> <Run Text="{Binding LastScan, Mode=OneWay}" /> <Run Text=" · 가장 오래된 기록" /> <Run Text="{Binding Oldest, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
