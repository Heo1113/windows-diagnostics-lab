<UserControl x:Class="WinDiag.App.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinDiag.App">
  <UserControl.Resources>
    <local:StatusBrushConverter x:Key="StatusBrush" />
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <local:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="2*" MinWidth="520" />
      <ColumnDefinition Width="*" MinWidth="320" MaxWidth="440" />
    </Grid.ColumnDefinitions>

    <!-- Filters -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="이벤트 탐색" Style="{StaticResource PageTitle}" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="검색어 (제목·메시지·공급자, 숫자는 이벤트 ID)" Style="{StaticResource Caption}" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
            <TextBlock Text="기간" Style="{StaticResource Caption}" />
            <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Name" Margin="0,2,0,4" />
            <StackPanel Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVisibility}}">
              <DatePicker SelectedDate="{Binding FromDate}" Margin="0,2" />
              <DatePicker SelectedDate="{Binding ToDate}" Margin="0,2" />
            </StackPanel>
            <TextBlock Text="중요도" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding SelectedSeverity}" DisplayMemberPath="Name" Margin="0,2,0,4" />
            <TextBlock Text="로그" Style="{StaticResource Caption}" />
            <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" DisplayMemberPath="Name" Margin="0,2,0,4" />
            <TextBlock Text="공급자 (정확한 이름)" Style="{StaticResource Caption}" />
            <TextBox Text="{Binding ProviderText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" ToolTip="예: Microsoft-Windows-WHEA-Logger, nvlddmkm, Display" />
            <CheckBox Content="마지막 확인 이후 새 이벤트만" IsChecked="{Binding OnlyNew}" Margin="0,2" />
            <CheckBox Content="같은 문제끼리 묶어 보기" IsChecked="{Binding GroupMode}" Margin="0,2" />
            <WrapPanel Margin="0,8,0,0">
              <Button Content="검색" Command="{Binding SearchCommand}" Style="{StaticResource ToolButton}" IsDefault="True" />
              <Button Content="필터 초기화" Command="{Binding ClearFiltersCommand}" Style="{StaticResource ToolButton}" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="없음" Command="{Binding SelectAllCategoriesCommand}" CommandParameter="none" Padding="6,0" />
              <Button DockPanel.Dock="Right" Content="모두" Command="{Binding SelectAllCategoriesCommand}" CommandParameter="all" Padding="6,0" Margin="0,0,4,0" />
              <TextBlock Text="분류" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,1" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Results -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="CSV 내보내기" Command="{Binding ExportCsvCommand}" Style="{StaticResource ToolButton}" Margin="0,0,6,0" />
            <Button Content="JSON 내보내기" Command="{Binding ExportJsonCommand}" Style="{StaticResource ToolButton}" Margin="0" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Value}" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding GroupFilter, Converter={StaticResource NotEmpty}}">
              <TextBlock Text="한 유형만 보는 중" Style="{StaticResource Caption}" VerticalAlignment="Center" />
              <Button Content="해제" Command="{Binding ClearGroupFilterCommand}" Padding="6,0" Margin="6,0,0,0" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <Grid>
          <DockPanel Visibility="{Binding GroupMode, Converter={StaticResource InverseBoolToVisibility}}">
            <Button DockPanel.Dock="Bottom" Content="더 불러오기" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Center" Margin="0,6,0,0" Padding="12,3"
                    Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVisibility}}" />
            <DataGrid ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="시각" Binding="{Binding Time, Mode=OneWay}" Width="SizeToCells" MinWidth="150" />
                <DataGridTemplateColumn Header="중요도" Width="58">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock Text="{Binding Severity}" Foreground="{Binding Level, Converter={StaticResource StatusBrush}}" Margin="2" /></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="분류" Binding="{Binding Category, Mode=OneWay}" Width="110" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="공급자" Binding="{Binding Provider, Mode=OneWay}" Width="120" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="ID" Binding="{Binding EventId, Mode=OneWay}" Width="SizeToCells" MinWidth="52" />
                <!-- The origin (live or history) is shown in the detail panel; the list keeps its width for the title. -->
                <DataGridTextColumn Header="내용" Binding="{Binding Title, Mode=OneWay}" Width="*" MinWidth="200" ElementStyle="{StaticResource TrimCell}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
          <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0"
                    Visibility="{Binding GroupMode, Converter={StaticResource BoolToVisibility}}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="중요도" Width="58">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Severity}" Foreground="{Binding Level, Converter={StaticResource StatusBrush}}" Margin="2" /></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="횟수" Binding="{Binding Count, Mode=OneWay}" Width="52" />
              <DataGridTextColumn Header="일수" Binding="{Binding Days, Mode=OneWay}" Width="44" />
              <DataGridTextColumn Header="분류" Binding="{Binding Category, Mode=OneWay}" Width="110" ElementStyle="{StaticResource TrimCell}" />
              <DataGridTextColumn Header="문제 (최근 기록 기준)" Binding="{Binding Title, Mode=OneWay}" Width="*" MinWidth="200" ElementStyle="{StaticResource TrimCell}" />
              <DataGridTextColumn Header="처음" Binding="{Binding First, Mode=OneWay}" Width="135" />
              <DataGridTextColumn Header="마지막" Binding="{Binding Last, Mode=OneWay}" Width="135" />
              <DataGridTemplateColumn Width="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="목록" Padding="6,0" Command="{Binding DataContext.ShowGroupEventsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </DockPanel>

    <!-- Detail -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Visibility="{Binding HasDetail, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="왼쪽 목록에서 이벤트를 선택하면 상세 정보가 표시됩니다." Style="{StaticResource Caption}" />
        </Border>
        <StackPanel Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding DetailFields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ToolTip="{Binding Note}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel Margin="0,8,0,0">
                <Button Content="전후 센서 보기" Command="{Binding ShowSensorsCommand}" Style="{StaticResource ToolButton}" />
                <Button Content="타임라인에서 보기" Command="{Binding ShowTimelineCommand}" Style="{StaticResource ToolButton}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="의미" Style="{StaticResource CardTitle}" />
              <TextBlock Text="{Binding DetailMeaning}" Style="{StaticResource Value}" />
              <TextBlock Text="이 이벤트만으로 알 수 없는 것" Style="{StaticResource CardTitle}" Margin="0,8,0,0" Visibility="{Binding DetailCaution, Converter={StaticResource NotEmpty}}" />
              <TextBlock Text="{Binding DetailCaution}" Style="{StaticResource Value}" Foreground="{StaticResource WarningBrush}" Visibility="{Binding DetailCaution, Converter={StaticResource NotEmpty}}" />
              <TextBlock Text="이벤트에서 읽은 값 (사실)" Style="{StaticResource CardTitle}" Margin="0,8,0,0" />
              <ItemsControl ItemsSource="{Binding DetailFacts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,2">
                      <TextBlock Style="{StaticResource Value}"><Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" /> <Run Text="{Binding Value, Mode=OneWay}" /></TextBlock>
                      <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Visibility="{Binding Note, Converter={StaticResource NotEmpty}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding DetailGroup}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="메시지 (개인정보 가림 적용)" Style="{StaticResource CardTitle}" />
              <TextBox Text="{Binding DetailMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8" />
              <TextBlock Text="이벤트 데이터" Style="{StaticResource CardTitle}" />
              <ItemsControl ItemsSource="{Binding DetailData}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="메모 (같은 유형의 이벤트에 공통)" Style="{StaticResource CardTitle}" />
              <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,4,0,6" />
              <Button Content="메모 저장" Command="{Binding SaveNoteCommand}" HorizontalAlignment="Left" Style="{StaticResource ToolButton}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
