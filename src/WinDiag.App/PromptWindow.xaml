<Window x:Class="WinDiag.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CardBrush}" ShowInTaskbar="False">
  <StackPanel Margin="18">
    <TextBlock x:Name="MessageText" Style="{StaticResource Value}" Margin="0,0,0,10" />
    <TextBox x:Name="Input" MaxLength="160" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="확인" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnOk" />
      <Button Content="취소" IsCancel="True" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
